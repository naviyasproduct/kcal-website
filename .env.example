# Copy to .env and fill in. Never commit .env. Nothing secret may use NEXT_PUBLIC_.

# Public base URL of the site, e.g. http://localhost:3000
APP_URL=

# PostgreSQL connection string, e.g. postgresql://USER:PASSWORD@localhost:5432/kcal
DATABASE_URL=

# Random string, at least 32 characters. Generate with: npx auth secret  (or)  openssl rand -base64 32
AUTH_SECRET=

# Chatbot model (step 9). Swapping model only needs these three values.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
